{
  "extends": [
    "@tsconfig/strictest/tsconfig.json",
    "@tsconfig/node24/tsconfig.json"
  ],
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "useDefineForClassFields": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src", "types"]
}
